.DS_Store
.vscode/
.idea/
*.swp

# --- Env / secrets ---
.env
*.token

# --- rtrrl-playground run artifacts ---
# Per-experiment scratch only. Figures are NOT excluded anywhere: plots are
# the point of a playground repo, and a global *.png rule silently drops new
# ones without anybody noticing.
runs/
