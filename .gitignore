# --- Benchmark outputs ---
# Measured results ARE the repo: every table and figure in the docs is
# generated from them, so a checkout without them cannot reproduce the pages.
# Only the bulky raw sweep dumps stay out.
benchmarks/results/raw/

# --- Docs build ---
docs/build/
docs/source/_build/
docs/_build/
docs/_build_test/

